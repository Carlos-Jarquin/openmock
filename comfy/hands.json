{
  "1": { "class_type": "UNETLoader", "_meta": { "title": "Z-Image Turbo" }, "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "_meta": { "title": "Qwen3 4B text encoder" }, "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ae.safetensors" } },
  "4": { "class_type": "ModelPatchLoader", "_meta": { "title": "Z-Image Fun ControlNet Union 2.1" }, "inputs": { "name": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors" } },
  "5": { "class_type": "LoadImage", "_meta": { "title": "Openmock beauty render" }, "inputs": { "image": "openmock_beauty.png" } },
  "6": { "class_type": "LoadImage", "_meta": { "title": "Openmock control (hand depth or OpenPose)" }, "inputs": { "image": "openmock_control.png" } },
  "7": { "class_type": "LoadImageMask", "_meta": { "title": "Openmock hand mask (inpaint area)" }, "inputs": { "image": "openmock_mask.png", "channel": "red" } },
  "8": { "class_type": "GrowMask", "inputs": { "mask": ["7", 0], "expand": 4, "tapered_corners": true } },
  "10": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3 } },
  "9": { "class_type": "ZImageFunControlnet", "_meta": { "title": "Control + inpaint (hands only)" }, "inputs": { "model": ["10", 0], "model_patch": ["4", 0], "vae": ["3", 0], "strength": 1.0, "image": ["6", 0], "inpaint_image": ["5", 0], "mask": ["8", 0] } },
  "11": { "class_type": "CLIPTextEncode", "_meta": { "title": "Prompt (set by Openmock)" }, "inputs": { "clip": ["2", 0], "text": "Photorealistic studio product photograph of a human hand holding a smartphone." } },
  "12": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["11", 0] } },
  "13": { "class_type": "EmptySD3LatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
  "14": { "class_type": "KSampler", "inputs": { "model": ["9", 0], "seed": 1, "steps": 8, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple", "positive": ["11", 0], "negative": ["12", 0], "latent_image": ["13", 0], "denoise": 1 } },
  "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
  "16": { "class_type": "LoadImageMask", "_meta": { "title": "Openmock soft hand alpha (visible hand only)" }, "inputs": { "image": "openmock_alpha.png", "channel": "red" } },
  "17": { "class_type": "InvertMask", "inputs": { "mask": ["16", 0] } },
  "18": { "class_type": "JoinImageWithAlpha", "_meta": { "title": "RGBA hand layer" }, "inputs": { "image": ["15", 0], "alpha": ["17", 0] } },
  "19": { "class_type": "SaveImage", "_meta": { "title": "Hand layer (RGBA)" }, "inputs": { "images": ["18", 0], "filename_prefix": "openmock/hands_layer" } },
  "20": { "class_type": "SaveImage", "_meta": { "title": "Full generation (for contact shadows)" }, "inputs": { "images": ["15", 0], "filename_prefix": "openmock/hands_full" } }
}
